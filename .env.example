# Local clone of luckperms/wiki (Nuxt Content in dev).
# WIKI_PATH=../luckperms-wiki
# Remote wiki cloned at build time when WIKI_PATH is unset (Cloudflare / CI).
# WIKI_REPO=https://github.com/Turbotailz/wiki
# After the wiki v3-structure branch is merged, omit WIKI_BRANCH (defaults to v3-structure until then).
# WIKI_BRANCH=master
# NUXT_PUBLIC_SELF_HOSTED=true
# NUXT_PUBLIC_BYTEBIN_URL=https://usercontent.luckperms.net/
# NUXT_PUBLIC_BYTESOCKS_HOST=usersockets.luckperms.net
# NUXT_PUBLIC_API_URL=https://metadata.luckperms.net
# Canonical site URL for OG images, sitemap, robots, and JSON-LD (build-time).
# Preview: NUXT_PUBLIC_SITE_URL=https://luckperms.tailz.dev
# Beta:    NUXT_PUBLIC_SITE_URL=https://beta.luckperms.net
# NUXT_PUBLIC_SITE_URL=https://luckperms.net
# Indexing. Default is true only for host luckperms.net. Beta and previews are noindex.
# NUXT_PUBLIC_SITE_INDEXABLE=false
# Plausible data-domain. Defaults to luckperms.net only on that host.
# Beta should be its own site: NUXT_PUBLIC_PLAUSIBLE_DOMAIN=beta.luckperms.net
# Footer commit links. Defaults to the fork these builds come from.
# NUXT_PUBLIC_WEB_REPO=https://github.com/Turbotailz/LuckPermsWeb
