# Local clone of luckperms/wiki (Nuxt Content in dev).
# WIKI_PATH=../luckperms-wiki
# Remote wiki used when WIKI_PATH is unset (Cloudflare / CI).
# WIKI_REPO=https://github.com/Turbotailz/wiki
# After the wiki v3-structure branch is merged, omit WIKI_BRANCH (defaults to v3-structure until then).
# WIKI_BRANCH=master
# NUXT_PUBLIC_SELF_HOSTED=true
# NUXT_PUBLIC_BYTEBIN_URL=https://usercontent.luckperms.net/
# NUXT_PUBLIC_BYTESOCKS_HOST=usersockets.luckperms.net
# NUXT_PUBLIC_API_URL=https://metadata.luckperms.net
# NUXT_PUBLIC_SITE_URL=https://luckperms.net
